{
  "name": "dnd.firegory",
  "version": "0.1.0",
  "private": true,
  "description": "Citation-first D&D 5e/5.5e search and RAG web app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.mts'",
    "qa:unit": "npm test",
    "qa:db": "node --test --experimental-strip-types tests/qa/database.qa.mts",
    "qa:publication": "node --test --experimental-strip-types tests/content-storage/publication.test.mts tests/qa/publication-process.qa.mts",
    "qa:performance": "node --test --experimental-strip-types tests/qa/performance.qa.mts",
    "qa:browser": "node --experimental-strip-types scripts/run-browser-qa.mts",
    "qa:browser:install": "playwright install --with-deps chromium",
    "qa:build": "npm run typecheck && npm run lint && npm run build",
    "db:migrate": "node --experimental-strip-types scripts/migrate.mts",
    "worker": "node --experimental-strip-types src/worker/index.ts",
    "ingest": "node --experimental-strip-types scripts/ingest.mts",
    "content-index": "node --experimental-strip-types scripts/content-index.mts",
    "collect:next-dnd": "node --experimental-strip-types scripts/collect-next-dnd-snapshots.mts",
    "corpus-seed": "node --experimental-strip-types scripts/corpus-seed.mts",
    "corpus-export": "node --experimental-strip-types scripts/corpus-export.mts",
    "agent-gateway": "node --experimental-strip-types scripts/agent-gateway.mts",
    "agent-healthcheck": "node --experimental-strip-types scripts/agent-healthcheck.mts",
    "agent-secret-hash": "node --experimental-strip-types scripts/agent-secret-hash.mts",
    "production:config": "node scripts/validate-production-compose.mjs",
    "production:smoke": "./scripts/production-smoke.sh",
    "production:up": "./scripts/production-up.sh -d --build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "type": "module"
}
