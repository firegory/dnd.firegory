{
  "name": "dnd.firegory",
  "version": "0.1.0",
  "private": true,
  "description": "Citation-first D&D 5e/5.5e search and RAG web app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'tests/**/*.test.mts'",
