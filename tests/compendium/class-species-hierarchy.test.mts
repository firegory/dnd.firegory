test("representative hierarchy fixtures preserve 1-20, parents, overrides, and anchors",()=>{assert.deepEqual(validateClassProjection(COMPLETE_CLASS).progressionRows.map((row)=>row.level),Array.from({length:20},(_,index)=>index+1));assert.equal(validateClassProjection(REPRESENTATIVE_SUBCLASS).parentClassIds[0],"class-fighter");assert.equal(validateSpeciesProjection(REPRESENTATIVE_SPECIES).kind,"species");assert.equal(validateSpeciesProjection(REPRESENTATIVE_VARIANT).traits[0].overrides,"resourceful");assert.throws(()=>validateClassProjection({...COMPLETE_CLASS,progressionRows:COMPLETE_CLASS.progressionRows.slice(1)}),/1 through 20/);});
