{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dnd-firegory:schema:content-repository:canonical-revision:1",
  "title": "Immutable canonical compendium revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "entryId", "revisionId", "contentHash", "createdAt", "source", "entry", "text", "citations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "canonicalRevision" },
    "entryId": { "$ref": "#/$defs/stableId" },
    "revisionId": { "type": "string", "pattern": "^rev-[0-9a-f]{64}$" },
    "contentHash": { "$ref": "#/$defs/contentHash" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "urn:dnd-firegory:schema:content-repository:source:1" },
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "fingerprintSha256", "rawBlobPath", "fetchedAt", "fileChecksumSha256", "index"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "fingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rawBlobPath": { "type": "string", "pattern": "^blobs/[0-9a-f]{64}\\.html$" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "fileChecksumSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "fingerprintSha256", "rawBlobPath", "fetchedAt", "cardFingerprintSha256", "metadataEvidenceText"],
          "properties": {
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "fingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "rawBlobPath": { "type": "string", "pattern": "^blobs/[0-9a-f]{64}\\.html$" },
            "fetchedAt": { "type": "string", "format": "date-time" },
            "cardFingerprintSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "metadataEvidenceText": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryType", "name", "aliases", "typedFields"],
      "properties": {
        "entryType": { "enum": ["rule", "action", "spell", "classFeature", "item", "monster", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "typedFields": { "type": "array", "items": { "$ref": "#/$defs/typedField" } }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plain", "sections"],
      "properties": {
        "plain": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sectionId", "heading", "text", "startOffset", "endOffset"],
            "properties": {
              "sectionId": { "$ref": "#/$defs/stableId" },
              "heading": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "startOffset": { "type": "integer", "minimum": 0 },
              "endOffset": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citationId", "sourceId", "fileId", "page", "section", "quote", "startOffset", "endOffset"],
        "properties": {
          "citationId": { "$ref": "#/$defs/stableId" },
          "sourceId": { "$ref": "#/$defs/stableId" },
          "fileId": { "$ref": "#/$defs/stableId" },
          "page": { "type": ["integer", "null"], "minimum": 1 },
          "section": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "startOffset": { "type": ["integer", "null"], "minimum": 0 },
          "endOffset": { "type": ["integer", "null"], "minimum": 1 },
          "fieldPath": { "type": "string", "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\])*$" },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "typedField": {
      "oneOf": [
        { "$ref": "#/$defs/stringField" },
        { "$ref": "#/$defs/numberField" },
        { "$ref": "#/$defs/booleanField" },
        { "$ref": "#/$defs/stringListField" }
      ]
    },
    "fieldBase": {
      "type": "object",
      "required": ["key", "label", "type", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "type": true,
        "value": true
      }
    },
    "stringField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "type": "object", "additionalProperties": false, "properties": { "key": true, "label": true, "type": { "const": "string" }, "value": { "type": "string" } } }
      ]
    },
    "numberField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "type": "object", "additionalProperties": false, "properties": { "key": true, "label": true, "type": { "const": "number" }, "value": { "type": "number" } } }
      ]
    },
    "booleanField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "type": "object", "additionalProperties": false, "properties": { "key": true, "label": true, "type": { "const": "boolean" }, "value": { "type": "boolean" } } }
      ]
    },
    "stringListField": {
      "allOf": [
        { "$ref": "#/$defs/fieldBase" },
        { "type": "object", "additionalProperties": false, "properties": { "key": true, "label": true, "type": { "const": "stringList" }, "value": { "type": "array", "items": { "type": "string" } } } }
      ]
    }
  }
}
