{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dnd-firegory:schema:content-repository:manifest:1",
  "title": "Content repository bootstrap descriptor",
  "description": "Bootstrap metadata for readerContractVersion 1. Active entries require folding valid activation deltas by target generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "readerContractVersion", "repositoryId", "schemas", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "repositoryManifest" },
    "readerContractVersion": { "const": 1 },
    "repositoryId": { "$ref": "#/$defs/stableId" },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaId", "path"],
        "properties": {
          "schemaId": { "type": "string", "pattern": "^urn:dnd-firegory:schema:" },
          "path": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "revisionId", "path", "contentHash"],
        "properties": {
          "entryId": { "$ref": "#/$defs/stableId" },
          "revisionId": { "type": "string", "pattern": "^rev-[0-9a-f]{64}$" },
          "path": { "$ref": "#/$defs/relativePath" },
          "contentHash": { "$ref": "#/$defs/contentHash" }
        }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,126}[a-z0-9])?$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
