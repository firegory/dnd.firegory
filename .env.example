# Copy to .env.local for Next.js/npm local overrides, or to .env for Docker Compose overrides.
# Keep real secrets out of git.

# App
APP_URL=
NEXT_PUBLIC_APP_URL=
APP_PORT=

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Redis
REDIS_URL=
REDIS_PORT=

# Auth
AUTH_SECRET=

# LLM provider
ZAI_API_KEY=

# Embedding provider: zai or ollama
# EMBEDDING_PROVIDER=zai
# EMBEDDING_DIMENSIONS=1024

# z.ai embedding config (optional overrides)
# ZAI_EMBEDDING_BASE_URL=
# ZAI_EMBEDDING_MODEL=
# ZAI_EMBEDDING_DIMENSIONS=

# Ollama embedding config (used when EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3
# OLLAMA_EMBEDDING_DIMENSIONS=1024
# OLLAMA_KEEP_ALIVE=1m

# LLM config (optional overrides, defaults to z.ai)
# ZAI_LLM_BASE_URL=
# ZAI_LLM_MODEL=
# ZAI_LLM_MAX_TOKENS=
# ZAI_LLM_TEMPERATURE=

# Storage
STORAGE_ROOT=
