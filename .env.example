# Copy to .env.local for Next.js/npm local overrides, or to .env for Docker Compose overrides.
# Keep real secrets out of git.

# App
APP_URL=
NEXT_PUBLIC_APP_URL=
APP_PORT=

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Redis
REDIS_URL=
REDIS_PORT=

# Auth
AUTH_SECRET=

# =============================================================================
# LLM configuration
# =============================================================================

# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.2

# =============================================================================
# Embedding configuration
# =============================================================================

# Embedding provider: openai or ollama
# EMBEDDING_PROVIDER=openai

# Generic embedding dimensions override (used as fallback for both ingestion and query)
# EMBEDDING_DIMENSIONS=1024

# OpenAI-compatible embedding config (optional overrides)
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Ollama embedding config (used when EMBEDDING_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBEDDING_MODEL=bge-m3
# OLLAMA_EMBEDDING_DIMENSIONS=1024
# OLLAMA_KEEP_ALIVE=1m

# =============================================================================
# Ingestion embedding config (worker/pipeline — e.g. remote Ollama on dev PC)
# =============================================================================
# Falls back to generic EMBEDDING_PROVIDER / OLLAMA_* / EMBEDDING_* if not set.
#
# INGESTION_EMBEDDING_PROVIDER=ollama
# INGESTION_OLLAMA_BASE_URL=http://192.168.0.101:11434
# INGESTION_OLLAMA_EMBEDDING_MODEL=bge-m3
# INGESTION_OLLAMA_EMBEDDING_DIMENSIONS=1024
# INGESTION_OLLAMA_KEEP_ALIVE=5m

# =============================================================================
# Query embedding config (vector search — e.g. local Ollama on deploy server)
# =============================================================================
# Falls back to generic EMBEDDING_PROVIDER / OLLAMA_* / EMBEDDING_* if not set.
#
# QUERY_EMBEDDING_PROVIDER=ollama
# QUERY_OLLAMA_BASE_URL=http://127.0.0.1:11434
# QUERY_OLLAMA_EMBEDDING_MODEL=bge-m3
# QUERY_OLLAMA_EMBEDDING_DIMENSIONS=1024
# QUERY_OLLAMA_KEEP_ALIVE=1m

# Storage
STORAGE_ROOT=
