# Copy to .env.local for Next.js/npm local overrides, or to .env for Docker Compose overrides.
# Keep real secrets out of git.

# App
APP_URL=
NEXT_PUBLIC_APP_URL=
APP_PORT=

# Database
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Redis
REDIS_URL=
REDIS_PORT=

# Auth
AUTH_SECRET=

# LLM / embedding provider
ZAI_API_KEY=

# Embedding config (optional overrides)
# ZAI_EMBEDDING_BASE_URL=
# ZAI_EMBEDDING_MODEL=
# ZAI_EMBEDDING_DIMENSIONS=

# LLM config (optional overrides, defaults to z.ai)
# ZAI_LLM_BASE_URL=
# ZAI_LLM_MODEL=
# ZAI_LLM_MAX_TOKENS=
# ZAI_LLM_TEMPERATURE=

# Storage
STORAGE_ROOT=
